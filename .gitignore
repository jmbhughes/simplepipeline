# ==============================================================================
# Python Core Files
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging outputs
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller (if bundling into standalone executables)
*.manifest
*.spec

# ==============================================================================
# Virtual Environments & Environments
# ==============================================================================
# Exclude standard environment directories 
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# Configuration & Sensitive Data
# ==============================================================================
# Never commit your environment variables or local credentials
.env.*
!.env.example
secrets.json

# ==============================================================================
# Testing & Code Quality Tools
# ==============================================================================
# Unit test and coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# IDEs and Text Editors
# ==============================================================================
# PyCharm
.idea/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Jupyter Notebooks
.ipynb_checkpoints

# Operating System Files
.DS_Store
Thumbs.db
